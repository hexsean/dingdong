# 由 dingdong setup 自动生成，也可手动编辑

# LLM (anthropic 或 openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 搜索（可选）
EXA_API_KEY=

# 调度
SCHEDULER_TZ=Asia/Shanghai
DATA_DIR=./data
HISTORY_LIMIT=20

# 白名单（逗号分隔，留空=不限）
ALLOWED_USER_IDS=
