# 由 dingdong setup 自动生成

# LLM (anthropic 或 openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MiMo Token Plan 示例（setup 中选择「MiMo Token Plan（官方订阅）」会自动写入）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=tp-xxxxx
# OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# OPENAI_MODEL=mimo-v2.5-pro

# 搜索（可选）
EXA_API_KEY=

# 调度
SCHEDULER_TZ=Asia/Shanghai
DATA_DIR=./data
HISTORY_LIMIT=20

# 白名单（逗号分隔，留空=不限）
ALLOWED_USER_IDS=

# 微信里发起更新（setup 会自动生成 updater 令牌）
WECHAT_UPDATE_ENABLED=false
WATCHTOWER_HTTP_API_TOKEN=
