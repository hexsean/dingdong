# ===== LLM provider =====
# Which provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI / OpenAI-compatible (DeepSeek, Kimi, ...)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Exa Search =====
EXA_API_KEY=

# ===== Bot =====
# Path for SQLite DB and session file
DATA_DIR=./data

# Timezone for scheduled jobs (IANA name)
SCHEDULER_TZ=Asia/Shanghai

# Long-poll timeout in ms (server enforces ~35s)
LONG_POLL_TIMEOUT_MS=35000

# Optional whitelist of user IDs allowed to control the bot.
# Comma-separated; leave empty to allow anyone who messages the bot.
ALLOWED_USER_IDS=
